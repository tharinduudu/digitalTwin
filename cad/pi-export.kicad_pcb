(kicad_pcb (version 20240108) (generator "pcbnew")
  (general (thickness 1.6))
  (paper "A4")
  (layers (0 "F.Cu" signal) (31 "B.Cu" signal) (44 "Edge.Cuts" user))
  (setup (pad_to_mask_clearance 0))
  (footprint "PiReference" (layer "F.Cu") (at 0 0)
    (property "Reference" "RaspberryPi5" (at 0 0) (layer "F.SilkS"))
    (property "Value" "CAD reference" (at 0 0) (layer "F.Fab"))
    (attr smd)
    (model "${KIPRJMOD}/pi5/rpi-5b_no_graphics.step"
      (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))))
